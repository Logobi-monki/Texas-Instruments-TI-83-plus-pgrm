CLRHOME
MENU("DIFFICULTY","EASY (5)",1,"MEDIUM (8)",2,"HARD (12)",3)
LBL 1
5->M:GOTO 4
LBL 2
8->M:GOTO 4
LBL 3
12->M
LBL 4
{5,10}->DIM([A])
{5,10}->DIM([B])
FILL(0,[A])
FILL(0,[B])
1->X:1->Y:0->S
CLRHOME

LBL 5
FOR(R,1,5)
FOR(C,1,10)
[B](R,C)->V
IF V=0:OUTPUT(R,C,".")
IF V=1:OUTPUT(R,C,SUB("0123456789",[A](R,C)+1,1))
IF V=2:OUTPUT(R,C,"F")
END:END

LBL 6
0->K
OUTPUT(Y,X,"+")
REPEAT K
GETKEY->K
END
[B](Y,X)->V
IF V=0:OUTPUT(Y,X,".")
IF V=1:OUTPUT(Y,X,SUB("0123456789",[A](Y,X)+1,1))
IF V=2:OUTPUT(Y,X,"F")

IF K=24 AND X>1:X-1->X
IF K=26 AND X<10:X+1->X
IF K=25 AND Y>1:Y-1->Y
IF K=34 AND Y<5:Y+1->Y
IF K=48 OR K=85:GOTO 7
IF K=105:GOTO 8
GOTO 6

LBL 7
IF [B](Y,X)=0:THEN
2->[B](Y,X)
ELSE
IF [B](Y,X)=2:0->[B](Y,X)
END
GOTO 5

LBL 8
IF [B](Y,X)=2:GOTO 6
IF S=0:THEN
1->S
0->I
WHILE I<M
RANDINT(1,5)->R
RANDINT(1,10)->C
IF [A](R,C)=0 AND (ABS(R-Y)>1 OR ABS(C-X)>1):THEN
9->[A](R,C)
I+1->I
END
END
FOR(R,1,5)
FOR(C,1,10)
IF [A](R,C)<9:THEN
0->N
FOR(I,-1,1)
FOR(J,-1,1)
IF R+I>0 AND R+I<6 AND C+J>0 AND C+J<11:THEN
IF [A](R+I,C+J)=9:N+1->N
END
END:END
N->[A](R,C)
END
END:END
END

1->[B](Y,X)
IF [A](Y,X)=9:GOTO 9
0->W
FOR(R,1,5)
FOR(C,1,10)
IF [B](R,C)=1:W+1->W
END:END
IF W=50-M:GOTO 0
GOTO 5

LBL 9
CLRHOME
FOR(R,1,5)
FOR(C,1,10)
IF [A](R,C)=9:OUTPUT(R,C,"*")
END:END
OUTPUT(7,1,"GAME OVER")
STOP

LBL 0
CLRHOME
OUTPUT(4,2,"YOU WIN!")
STOP
